
# Server-only: required by the verified Mux webhook to update processing status.
# Never prefix private keys with NEXT_PUBLIC_.

# Server-only Mux Video API credentials
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Public app origin, used for direct-upload CORS and webhook setup instructions
APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Local-only synthetic preview. Do not enable in production.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_UI=false
